# Supabase project the live app uses (tire wear tables are namespaced tw_).
# Not allen-qc: that holds an older copy the app no longer reads.
VITE_SUPABASE_URL=https://qgsdpbgpftktaqncwdch.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# Motive sync (server side only — these are read by the Netlify Functions,
# never by the browser, so they deliberately have no VITE_ prefix).
# MOTIVE_API_KEY is the organisation API key from the Motive dashboard.
# SYNC_TOKEN is any long random string; it gates writing from the
# on-demand endpoint. Without it that endpoint can only report a dry run.
# Also needed by the functions, unprefixed because a VITE_ variable is
# compiled into the browser bundle and is scoped to builds only.
SUPABASE_URL=https://qgsdpbgpftktaqncwdch.supabase.co
SUPABASE_ANON_KEY=your-publishable-key-here
MOTIVE_API_KEY=
SYNC_TOKEN=
